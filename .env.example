# ========================================================
# AI Lead Finder - Environment Configuration
# ========================================================

# Application Environment
NODE_ENV=development
PORT=5001

# URLs for CORS and Client communication
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# Database Configuration (PostgreSQL with Prisma)
# In production (e.g. Supabase):
# DATABASE_URL uses the connection pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL uses the direct database connection (port 5432) for running migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_lead_finder?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_lead_finder?schema=public"

# Redis Configuration (BullMQ Queues)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# AI Engine (Google Gemini)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Social Platform Discovery (X / Twitter API v2)
# Required only for automatic X recent search; leave placeholder if using manual/import mode
X_BEARER_TOKEN="your-x-api-bearer-token-here"

# Tavily Search API (Automated Search Mode)
# Obtain from Tavily: https://tavily.com/
TAVILY_API_KEY="your-tavily-api-key-here"

# Rate Limiting & Safety
MAX_SEARCH_RESULTS_PER_RUN=50
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
